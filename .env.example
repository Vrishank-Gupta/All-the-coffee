# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Supabase project settings -> API page
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay keys are NOT set here. They live server-side only, as Supabase
# Edge Function secrets (see supabase/functions/README.md), because the
# order-creation and payment-verification calls need the secret key and
# must never run in the browser.
